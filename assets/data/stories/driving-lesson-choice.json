  "dialogues": [
    {
      "order": 1,
      "speakerId": "narrator",
      "type": "narration",
      "english": "A nervous student was having his first driving lesson.",
      "translation": "Một học viên lo lắng đang có buổi học lái xe đầu tiên."
    },
    {
      "order": 2,
      "speakerId": "narrator",
      "type": "narration",
      "english": "His instructor decided to test his thinking.",
      "translation": "Thầy giáo của anh ấy quyết định kiểm tra cách suy nghĩ của anh."
    },
    {
      "order": 3,
      "speakerId": "instructor",
      "type": "dialogue",
      "english": "Imagine this. You are driving on a narrow road.",
      "translation": "Hãy tưởng tượng. Em đang lái xe trên một con đường hẹp."
    },
    {
      "order": 4,
      "speakerId": "instructor",
      "type": "dialogue",
      "english": "In front of you, there are your best friend and your ex.",
      "translation": "Trước mặt em là bạn thân và người yêu cũ."
    },
    {
      "order": 5,
      "speakerId": "instructor",
      "type": "dialogue",
      "english": "What would you do?",
      "translation": "Em sẽ làm gì?"
    },
    {
      "order": 6,
      "speakerId": "student",
      "type": "dialogue",
      "english": "If I have to choose, I will hit my ex.",
      "translation": "Nếu phải chọn, em sẽ đâm người yêu cũ."
    },
    {
      "order": 7,
      "speakerId": "narrator",
      "type": "narration",
      "english": "The instructor looked shocked.",
      "translation": "Thầy giáo trông rất sốc."
    },
    {
      "order": 8,
      "speakerId": "instructor",
      "type": "dialogue",
      "english": "No! You press the brake!",
      "translation": "Không! Em phải đạp phanh!"
    },
    {
      "order": 9,
      "speakerId": "narrator",
      "type": "narration",
      "english": "The student suddenly understood.",
      "translation": "Học viên chợt hiểu ra."
    },
    {
      "order": 10,
      "speakerId": "student",
      "type": "dialogue",
      "english": "Oh... right. That makes sense.",
      "translation": "Ồ... đúng rồi. Hợp lý thật."
    }
