  "book": "Story Learning",
  "title": "Luôn cố giữ im lặng trong những trường hợp sau:",
  "subtitle": "Always try to stay silent in these situations:",
  "paragraphs": [
    {
      "segments": [
        {
          "vi": "Hãy im lặng",
          "en": "Be silent"
        },
        {
          "vi": "nếu bạn chưa có",
          "en": "if you don't have"
        },
        {
          "vi": "đủ kiến thức về điều gì đó",
          "en": "full knowledge of something."
        },
        {
          "vi": "Hãy im lặng",
          "en": "Be silent"
        },
        {
          "vi": "nếu ai đó không coi trọng",
          "en": "if someone doesn't value"
        },
        {
          "vi": "lời nói của bạn",
          "en": "your words."
        },
        {
          "vi": "Hãy im lặng",
          "en": "Be silent"
        },
        {
          "vi": "nếu bạn đang trong lúc",
          "en": "if you are in a stage"
        },
        {
          "vi": "nóng giận",
          "en": "of anger"
        },
        {
          "vi": "Hãy im lặng",
          "en": "Be silent"
        },
        {
          "vi": "nếu bạn muốn",
          "en": "if you want to"
        },
        {
          "vi": "quan sát nhiều hơn",
          "en": "observe more."
        }
      ]
    }
  ]
