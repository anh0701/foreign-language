  "title": "Nếu bạn thành công",
  "subtitle": "If you succeed",
  "paragraphs": [
    {
      "segments": [
        {
          "vi": "Nếu bạn thành công",
          "en": "If you succeed"
        },
        {
          "vi": "trong việc lừa dối ai đó",
          "en": "in cheating someone,"
        },
        {
          "vi": "đừng nghĩ rằng",
          "en": "don't think"
        },
        {
          "vi": "người đó là một kẻ ngốc",
          "en": "that person is a fool."
        },
        {
          "vi": "Hãy nhận ra rằng",
          "en": "Realize that"
        },
        {
          "vi": "người đó đã tin tưởng bạn",
          "en": "the person trusted you"
        },
        {
          "vi": "nhiều hơn những gì bạn xứng đáng",
          "en": "more than you deserved."
        }
      ]
    }
  ]
}