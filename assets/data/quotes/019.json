  "book": "Story Learning",
  "title": "Những điều không định nghĩa con người của bạn",
  "subtitle": "Things that do not define who you are",
  "paragraphs": [
    {
        "segments": [
            {
              "vi": "Ý kiến của người khác về bạn",
              "en": "Other people's opinions of you."
            },
            {
              "vi": "Những sai lầm",
              "en": "The mistakes"
            },
            {
              "vi": "bạn đã mắc phải",
              "en": "you have made."
            },
            {
              "vi": "Số người theo dõi trên mạng xã hội của bạn",
              "en": "Your social media followers number."
            },
            {
              "vi": "Công việc của bạn",
              "en": "Your job,"
            },
            {
              "vi": "tiền lương của bạn",
              "en": "your salary"
            },
            {
              "vi": "và tài sản của bạn",
              "en": "and your possessions."
            },
            {
              "vi": "Số lượng bạn bè",
              "en": "The number of friends"
            },
            {
              "vi": "bạn có",
              "en": "you have."
            },
            {
              "vi": "Ngoại hình",
              "en": "Your physical appearance"
            },
            {
              "vi": "hoặc tuổi tác của bạn",
              "en": "or your age."
            },
            {
              "vi": "Tình trạng quan hệ của bạn",
              "en": "Your relationship status."
            },
            {
              "vi": "Những vết thương tích trong quá khứ của bạn",
              "en": "The bruises of your past."
            },
            {
              "vi": "Những lúc bạn không phải là",
              "en": "The times you weren't"
            },
            {
              "vi": "con người tốt nhất của mình",
              "en": "your best self."
            }
        ]
    }
  ]
}