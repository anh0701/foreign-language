                "vi": "Một ngày nào đó",
                "en": "One day"
            },
            {
                "vi": "sẽ có người đến",
                "en": "someone is going to"
            },
            {
                "vi": "ôm bạn thật chặt đến nỗi",
                "en": "hug you so tight that"
            },
            {
                "vi": "tất cả những mảnh vụn vỡ của bạn",
                "en": "all of your broken pieces"
            },
