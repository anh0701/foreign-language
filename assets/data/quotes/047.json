{
  "id": 47,
  "page": 47,
  "book": "Story Learning",
  "title": "Hãy làm việc trong thầm lặng",
  "subtitle": "Work in silence",
  "paragraphs": [
    {
      "segments": [
        {
          "vi": "Hãy làm việc",
          "en": "Work"
        },
        {
          "vi": "trong thầm lặng",
          "en": "in silence."
        },
        {
          "vi": "Đôi khi",
          "en": "Sometimes"
        },
        {
          "vi": "bạn phải biến mất",
          "en": "you've got to disappear."
        },
        {
          "vi": "Sau đó trở lại",
          "en": "Then come back"
        },
        {
          "vi": "và làm cho thiên hạ sửng sốt",
          "en": "and shock the world."
        },
        {
          "vi": "Gây sốc tất cả những người",
          "en": "Shock everybody"
        },
        {
          "vi": "đã nghi ngờ bạn",
          "en": "who doubted you"
        },
        {
          "vi": "Bạn cần",
          "en": "You need to"
        },
        {
          "vi": "lùi lại một bước",
          "en": "take a step back"
        },
        {
          "vi": "và tự hỏi bản thân rằng",
          "en": "and ask yourself."
        },
        {
          "vi": "`Tại sao tôi có mặt trên đời này`",
          "en": "Why am I here?"
        },
        {
          "vi": "`Mục đích sống của tôi là gì?`",
          "en": "What is my purpose?"
        },
        {
          "vi": "Và rồi bạn phải",
          "en": "And you have to"
        },
        {
          "vi": "nhắm tới vị trí đỉnh cao",
          "en": "be aiming for the top."
        }
      ]
    }
  ]
}