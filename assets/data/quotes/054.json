{
  "id": 54,
  "page": 54,
  "book": "Story Learning",
  "title": "Đừng kết hôn vì",
  "subtitle": "Don't marry because",
  "paragraphs": [
    {
      "segments": [
        {
          "vi": "Bạn cảm thấy cô đơn",
          "en": "You feel lonely"
        },
        {
          "vi": "và tin rằng hôn nhân",
          "en": "and believe marriage"
        },
        {
          "vi": "sẽ giải quyết được nỗi cô đơn đó",
          "en": "will solve that loneliness."
        },
        {
          "vi": "Bạn cần",
          "en": "You need"
        },
        {
          "vi": "một lối thoát khỏi cuộc sống",
          "en": "an escape from your life"
        },
        {
          "vi": "hoặc những vấn đề cá nhân mình",
          "en": "or personal problems."
        },
        {
          "vi": "Bạn chỉ muốn",
          "en": "You just want to"
        },
        {
          "vi": "làm hài lòng bố mẹ bạn",
          "en": "please your parents."
        }
      ]
    }
  ]
}