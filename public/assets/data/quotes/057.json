  "title": "Không áp lực. Không có kim cương.",
  "subtitle": "No pressure. No diamonds.",
  "paragraphs": [
    {
      "segments": [
        {
          "vi": "Hãy nhớ rằng",
          "en": "Remember,"
        },
        {
          "vi": "trong những khoảnh khắc yếu đuối nhất của bạn",
          "en": "in your weakest moments,"
        },
        {
          "vi": "phiên bản mạnh mẽ nhất của bạn",
          "en": "the strongest version of you"
        },
        {
          "vi": "đang chờ được sinh ra",
          "en": "was waiting to be born."
        },
        {
          "vi": "Không áp lực",
          "en": "No pressure."
        },
        {
          "vi": "Không có kim cương",
          "en": "No diamonds."
        }
      ]
    }
  ]
}