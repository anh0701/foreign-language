  "book": "Story Learning",
  "title": "Bình yên tận hưởng cuộc sống độc thân",
  "subtitle": "Enjoy your single life in peace",
  "paragraphs": [
    {
        "segments": [
          {
            "vi": "Nếu không tìm được",
            "en": "If you can't find"
          },
          {
            "vi": "tình yêu đích thực",
            "en": "true love,"
          },
          {
            "vi": "hãy chăm chỉ làm việc",
            "en": "work hard,"
          },
          {
            "vi": "kiếm tiền",
            "en": "make money"
          },
          {
            "vi": "và an yên tận hưởng cuộc sống độc thân",
            "en": "and enjoy your single life in peace."
          },
          {
            "vi": "Chưa từng có ai chết",
            "en": "Nobody has ever died"
          },
          {
            "vi": "vì độc thân",
            "en": "from being single,"
          },
          {
            "vi": "nhưng nhiều người đã chết",
            "en": "but many have died"
          },
          {
            "vi": "vì lấy nhầm bạn đời",
            "en": "from being with the wrong partner."
          }
        ]
    }
  ]
}