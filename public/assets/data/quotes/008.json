{
  "id": 8,
  "page": 8,
  "book": "Story Learning",
  "title": "Tình yêu",
  "subtitle": "Love",
  "paragraphs": [
    {
        "segments": [
            {
                "vi": "Nếu bạn yêu",
                "en": "If you love"
            },
            {
              "vi": "một bông hoa",
              "en": "a flower,"
            },
            {
              "vi": "đừng hái nó",
              "en": "don't pick it."
            },
            {
              "vi": "Vì nếu bạn hái nó",
              "en": "Because if you pick it up,"
            },
            {
              "vi": "nó sẽ chết đi",
              "en": "it dies"
            },
            {
              "vi": "và không còn là",
              "en": "and ceases to be"
            },
            {
              "vi": "thứ bạn yêu thích nữa",
              "en": "what you love."
            },
            {
              "vi": "Vì vậy",
              "en": "So,"
            },
            {
              "vi": "nếu bạn yêu một bông hoa",
              "en": "if you love a flower,"
            },
            {
              "vi": "hãy cứ để nó như vậy",
              "en": "let it be."
            },
            {
              "vi": "Tình yêu không phải là",
              "en": "Love is not about"
            },
            {
              "vi": "sự sở hữu",
              "en": "possession."
            },
            {
              "vi": "Tình yêu chính là",
              "en": "Love is about"
            },
            {
              "vi": "sự trân trọng",
              "en": "appreciation."
            }
        ]
    }
  ]
}