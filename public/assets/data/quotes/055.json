  "title": "Hãy kết hôn vì",
  "subtitle": "Marry because",
  "paragraphs": [
    {
      "segments": [
        {
          "vi": "Bạn thực sự",
          "en": "You are genuinely"
        },
        {
          "vi": "chuẩn bị cho sự cam kết",
          "en": "prepared for the commitment"
        },
        {
          "vi": "cho những thứ mà hôn nhân đòi hỏi",
          "en": "that marriage entails."
        },
        {
          "vi": "Bạn đã ưu tiên",
          "en": "You have prioritized"
        },
        {
          "vi": "sự phát triển bản thân",
          "en": "your own personal growth"
        },
        {
          "vi": "và chữa lành",
          "en": "and healing"
        },
        {
          "vi": "và sẵn sàng chia sẻ",
          "en": "and are ready to share"
        },
        {
          "vi": "hành trình đó",
          "en": "that journey"
        },
        {
          "vi": "với đối phương",
          "en": "with a partner."
        },
        {
          "vi": "Bạn mong muốn xây dựng",
          "en": "You desire to build"
        },
        {
          "vi": "cuộc sống với một người",
          "en": "a life with someone"
        },
        {
          "vi": "tương thích với",
          "en": "who is compatible with"
        },
        {
          "vi": "các giá trị",
          "en": "your values,"
        },
        {
          "vi": "sở thích",
          "en": "interests"
        },
        {
          "vi": "và mục tiêu cuộc đời bạn",
          "en": "and life goals."
        }
      ]
    }
  ]
