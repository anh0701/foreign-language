          "vi": "Một người đàn ông đích thực",
          "en": "A real man"
        },
        {
          "vi": "không yêu một ngàn cô gái",
          "en": "doesn't love a thousand girls."
        },
        {
          "vi": "Anh ấy yêu một cô gái",
          "en": "He loves a girl"
